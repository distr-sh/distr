---
apiVersion: v1
kind: ConfigMap
metadata:
  name: distr-{{ .controllerName }}-env
data:
  DISTR_TARGET_ID: "{{ .targetId }}"
  DISTR_LOGIN_ENDPOINT: "{{ .loginEndpoint }}"
  DISTR_MANIFEST_ENDPOINT: "{{ .manifestEndpoint }}"
  DISTR_RESOURCE_ENDPOINT: "{{ .resourcesEndpoint }}"
  DISTR_STATUS_ENDPOINT: "{{ .statusEndpoint }}"
  DISTR_METRICS_ENDPOINT: "{{ .metricsEndpoint }}"
  DISTR_DEPLOYMENT_METRICS_ENDPOINT: "{{ .deploymentMetricsEndpoint }}"
  DISTR_LOGS_ENDPOINT: "{{ .logsEndpoint }}"
  DISTR_DEPLOYMENT_TARGET_LOGS_ENDPOINT: "{{ .deploymentTargetLogsEndpoint }}"
  DISTR_CONTROLLER_INTERVAL: "{{ .controllerInterval }}"
  DISTR_CONTROLLER_VERSION_ID: "{{ .controllerVersionId }}"
  {{- if .registryEnabled }}
  DISTR_REGISTRY_HOST: "{{ .registryHost }}"
  DISTR_REGISTRY_PLAIN_HTTP: "{{ .registryPlainHttp }}"
  {{- end }}

{{ if .targetSecret }}
---
apiVersion: v1
kind: Secret
metadata:
  name: distr-{{ .controllerName }}-auth
type: Opaque
stringData:
  DISTR_TARGET_SECRET: "{{ .targetSecret }}"

{{ end }}
{{ if .controllerDockerConfig }}
---
apiVersion: v1
kind: Secret
metadata:
  name: distr-{{ .controllerName }}-dockerconfig
type: Opaque
data:
  config.json: {{ .controllerDockerConfig }}

{{ end }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: distr-{{ .controllerName }}

{{ if eq .targetScope "namespace" }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: namespace-admin
rules:
  - apiGroups:
      - "*"
    resources:
      - "*"
    verbs:
      - "*"

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: distr-{{ .controllerName }}
subjects:
  - kind: ServiceAccount
    name: distr-{{ .controllerName }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: namespace-admin

{{ else }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: distr-{{ .controllerName }}-{{ .targetNamespace }}
subjects:
  - kind: ServiceAccount
    name: distr-{{ .controllerName }}
    namespace: {{ .targetNamespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin

{{ end }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: distr-{{ .controllerName }}
spec:
  selector:
    matchLabels:
      app: distr-{{ .controllerName }}
  replicas: 1
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: distr-{{ .controllerName }}
    spec:
      serviceAccountName: distr-{{ .controllerName }}
      securityContext:
        runAsNonRoot: true
      containers:
        - name: distr-{{ .controllerName }}
          image: "ghcr.io/distr-sh/distr/kubernetes-controller:{{ .controllerVersion }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: DOCKER_CONFIG
              value: /opt/config/.docker/
            - name: DISTR_CONTROLLER_CONFIG_DIRS
              value: |
                /opt/config/.controller/env
                /opt/config/.controller/auth
          envFrom:
            - secretRef:
                name: distr-{{ .controllerName }}-auth
            - configMapRef:
                name: distr-{{ .controllerName }}-env
          ports:
            - containerPort: 8765
          livenessProbe:
            httpGet:
              path: /
              port: 8765
            initialDelaySeconds: 10
            periodSeconds: 60
            failureThreshold: 2
          readinessProbe:
            httpGet:
              path: /
              port: 8765
            initialDelaySeconds: 10
            periodSeconds: 60
            failureThreshold: 2
          resources:
            {{- if .targetResources }}
            limits:
              memory: "{{ .targetResources.MemoryLimit }}"
              cpu: "{{ .targetResources.CPULimit }}"
            requests:
              memory: "{{ .targetResources.MemoryRequest }}"
              cpu: "{{ .targetResources.CPURequest }}"
            {{- else }}
            limits:
              memory: "256Mi"
              cpu: "500m"
            requests:
              memory: "256Mi"
            {{- end }}
          volumeMounts:
            - name: dockerconfig
              mountPath: /opt/config/.docker/
            - name: env
              mountPath: /opt/config/.controller/env
            - name: auth
              mountPath: /opt/config/.controller/auth
            - name: cache
              mountPath: /.cache/
      volumes:
        - name: env
          configMap:
            name: distr-{{ .controllerName }}-env
        - name: auth
          secret:
            secretName: distr-{{ .controllerName }}-auth
        - name: dockerconfig
          secret:
            secretName: distr-{{ .controllerName }}-dockerconfig
            optional: true
        - name: cache
          emptyDir: {}

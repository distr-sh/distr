---
import {getCollection, render} from 'astro:content';
import Layout from '~/layouts/StarlightLayout.astro';
import SignUpCta from '~/components/cta/standalone/SignUpCta.astro';
import CompareHero from '~/components/compare/CompareHero.astro';
import FAQ from '~/components/common/FAQ.astro';
import TestimonialsSection from '~/components/home/TestimonialsSection.astro';

export async function getStaticPaths() {
  const comparisons = await getCollection('compare');
  return comparisons.map(comparison => ({
    params: {slug: comparison.data.slug},
    props: {comparison},
  }));
}

const {comparison} = Astro.props;
const {Content} = await render(comparison);
const {title, description, heroImage, heading, subheading, faqs} =
  comparison.data;
---

<style>
  .prose {
    p {
      @apply hyphens-auto text-justify;
      margin-top: 1rem;
      margin-bottom: 1rem;
    }
    pre {
      margin-top: 2rem;
    }
    ul,
    ol {
      margin-top: 2rem;
    }
    table {
      margin-top: 2rem;
    }
  }

  .prose :global(.link-button) {
    display: flex;
    width: fit-content;
    margin-inline: auto;
    margin-top: 1.5rem;
  }
</style>

<Layout title={title} description={description}>
  <div class="mx-auto max-w-7xl px-1 sm:px-8 lg:px-10">
    <section class="pt-8 sm:y-12 mx-auto">
      <article class="max-w-4xl mx-auto px-6 sm:px-8">
        <CompareHero
          title={title}
          description={description}
          heroImage={heroImage}
          heading={heading}
          subheading={subheading}
        />

        <div
          class="prose prose-lg dark:prose-invert max-w-none
                 prose-headings:font-bold prose-headings:tracking-tight
                 prose-h2:text-xl prose-h2:mt-12 prose-h2:mb-4
                 prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
                 prose-h4:text-base prose-h4:mt-6 prose-h4:mb-2
                 prose-p:leading-relaxed prose-p:mb-6
                 prose-a:text-blue-600 dark:prose-a:text-blue-400
                 prose-a:no-underline hover:prose-a:underline
                 prose-code:text-sm prose-code:bg-gray-100 dark:prose-code:bg-gray-800
                 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                 prose-pre:bg-gray-100 dark:prose-pre:bg-slate-900
                 prose-pre:border prose-pre:border-gray-200 dark:prose-pre:border-slate-700
                 prose-ul:mt-8 prose-ul:mb-6 prose-ol:mt-8 prose-ol:mb-6 prose-li:my-2
                 prose-img:rounded-lg prose-img:my-8">
          <Content />
        </div>
      </article>
    </section>
  </div>
  {faqs.length > 0 && <FAQ faqs={faqs} />}
  <SignUpCta bgClass="bg-[var(--sl-color-bg)]" />
  <TestimonialsSection />
</Layout>

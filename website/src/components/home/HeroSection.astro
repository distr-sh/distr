---
import DemoButton from '~/components/buttons/DemoButton.astro';
import SignupButton from '~/components/buttons/SignupButton.astro';
import HeroCarousel from './HeroCarousel.astro';
import {images} from '~/assets/index';

// Every industry is rendered into the HTML and only the visibility is
// animated, so crawlers that do not execute JavaScript still read the
// full list. Keep this in sync with the "Why Distr" section of README.md.
const industries = [
  'GovCloud and defense',
  'regulated banking',
  'health tech',
  'manufacturing',
  'enterprise AI',
  'developer tools',
];
const secondsPerIndustry = 2.5;
const cycleSeconds = industries.length * secondsPerIndustry;
---

<header
  class="relative overflow-hidden bg-gradient-to-br from-accent-950 via-accent-700 to-accent-600 py-8 md:py-16"
  style="color: white;">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="text-center max-w-5xl mx-auto">
      <h1
        class="text-3xl md:text-5xl lg:text-6xl font-bold mb-6 md:mb-8 leading-tight"
        style="color: white;">
        Ship self-hosted software
      </h1>
      <p
        class="mx-auto mb-8 max-w-3xl text-lg md:text-xl leading-relaxed text-white/90">
        Start simple, scale as you go. Onboard to Distr and setup Docker Compose
        POCs in minutes, Helm and air-gapped when the deal needs it. All the
        tools you need to succeed with offering self-hosted. Proven in <span
          class="industry-rotator"
          aria-label={industries.join(', ')}
          >{
            industries.map((industry, i) => (
              <span
                aria-hidden="true"
                style={`animation-delay: ${i * secondsPerIndustry}s`}>
                {industry}
                <span class="industry-stop">.</span>
              </span>
            ))
          }</span
        >
      </p>
    </div>

    <div class="flex flex-col items-center gap-4 mb-8">
      <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
        <DemoButton class="w-full md:w-auto" />
        <SignupButton class="w-full md:w-auto" />
      </div>

      <div class="mt-6 md:mt-10 text-center">
        <h4 class="text-base md:text-lg mb-2 opacity-90" style="color: white;">
          Backed by
        </h4>
        <a
          href="https://www.ycombinator.com/companies/glasskube"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block transition-opacity hover:opacity-80">
          <img
            src={images.yc.badge.src}
            alt="Glasskube backed by Y Combinator"
            class="h-10 md:h-12 mx-auto"
          />
        </a>
      </div>
    </div>

    <div class="mt-8 md:mt-16 mb-8 md:mb-16">
      <HeroCarousel />
    </div>
  </div>
</header>

<style define:vars={{cycleSeconds: `${cycleSeconds}s`}}>
  /* Stacking every option in one grid cell sizes the slot to the widest
     industry, so the sentence around it never reflows mid-cycle. */
  .industry-rotator {
    display: inline-grid;
    vertical-align: bottom;
    text-align: left;
  }

  .industry-rotator > span {
    grid-area: 1 / 1;
    opacity: 0;
    white-space: nowrap;
    font-weight: 600;
    animation: industry-cycle var(--cycleSeconds) infinite;
  }

  @keyframes industry-cycle {
    0% {
      opacity: 0;
      transform: translateY(0.25em);
    }
    2%,
    14.5% {
      opacity: 1;
      transform: translateY(0);
    }
    16.66%,
    100% {
      opacity: 0;
      transform: translateY(-0.25em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .industry-rotator {
      display: inline;
    }

    .industry-rotator > span {
      grid-area: auto;
      opacity: 1;
      transform: none;
      white-space: normal;
      animation: none;
    }

    .industry-rotator > span:not(:last-child)::after {
      content: ', ';
    }

    /* The full stop rides inside each option so the fixed-width slot cannot
       orphan it while rotating. Inline, only the final one belongs. */
    .industry-rotator > span:not(:last-child) .industry-stop {
      display: none;
    }
  }
</style>

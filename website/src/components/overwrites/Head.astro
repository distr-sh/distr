---
import {Font} from 'astro:assets';
import GoogleTagManager from '~/components/telemetry/GoogleTagManager.astro';
import PostHog from '~/components/telemetry/PostHog.astro';
const {head, entry} = Astro.locals.starlightRoute;

const markdownAlternate =
  entry.id === 'docs' || entry.id.startsWith('docs/')
    ? new URL(`/${entry.id}.md`, Astro.site).href
    : undefined;

const hasOgImage = head.some(
  ({tag, attrs}) => tag === 'meta' && attrs?.property === 'og:image',
);
const ogImageUrl = hasOgImage
  ? undefined
  : new URL('/og-distr.webp', Astro.site).href;
---

<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-poppins" preload />
{head.map(({tag: Tag, attrs, content}) =>
  content !== undefined && content !== null ? (
    <Tag {...attrs} set:html={content} />
  ) : (
    <Tag {...attrs} />
  ),
)}
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{markdownAlternate && (
  <link rel="alternate" type="text/markdown" href={markdownAlternate} />
)}
{import.meta.env.PROD && <GoogleTagManager />}
{import.meta.env.PROD && <PostHog />}

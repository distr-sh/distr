---
import {BOOKING_FLOW_STORAGE_KEY} from '~/utils/analytics';

// Paths where session replay is useful. Recording blog and docs reading is high
// volume and low signal, so replay starts only on conversion flows.
const REPLAY_PATHS = ['/onboarding', '/contact', '/pricing'];
---


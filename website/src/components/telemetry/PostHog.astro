  posthog.init('phc_kT9cJBgrQwRx9ayg0PUQkukLFowbTfN47jQuWqScglR', {
    api_host: 'https://edge.distr.sh',
    ui_host: 'https://eu.posthog.com',
    defaults: '2026-05-30',
    person_profiles: 'identified_only',
    // The shared .distr.sh cookie must beat stale per-origin localStorage,
    // otherwise distr.sh and app.distr.sh disagree about who a visitor is.
    cookieWinsOnConflict: true,
    disable_session_recording: true,
  });

  if (REPLAY_PATHS.some(path => window.location.pathname.startsWith(path))) {
    posthog.startSessionRecording();
  }

  // Demo links live in components and in blog markdown, so one delegated
  // listener covers all of them.
  document.addEventListener('click', event => {
    const link =
      event.target instanceof Element &&
      event.target.closest('a[href*="cal.glasskube.com/team/gk/demo"]');
    if (!link) return;

    try {
      localStorage.setItem(BOOKING_FLOW_STORAGE_KEY, 'demo');
    } catch {
      // Storage can be blocked; the click is still captured below.
    }
    posthog.capture('demo_cta_clicked', {
      placement: link.closest('header') ? 'header' : 'page',
      link_text: link.textContent.trim(),

      (e.__SV = 1));
  })(document, window.posthog || []);

  posthog.init('phc_kT9cJBgrQwRx9ayg0PUQkukLFowbTfN47jQuWqScglR', {
    api_host: 'https://edge.distr.sh',
    ui_host: 'https://eu.posthog.com',
    defaults: '2026-08-30',
    person_profiles: 'identified_only',
    disable_session_recording: true,
  });

  if (REPLAY_PATHS.some(path => window.location.pathname.startsWith(path))) {
    posthog.startSessionRecording();
  }

  // Demo entry points live in components, blog markdown and the mobile menu's
  // <select>, so document-level listeners cover all of them.
  const DEMO_URL = 'cal.glasskube.com/team/gk/demo';

  function trackDemoIntent(placement, linkText) {
    try {
      localStorage.setItem(BOOKING_FLOW_STORAGE_KEY, 'demo');
    } catch {
      // Storage can be blocked; the click is still captured below.
    }
    posthog.capture('demo_cta_clicked', {placement, link_text: linkText});
  }

  document.addEventListener('click', event => {
    const link =
      event.target instanceof Element &&
      event.target.closest(`a[href*="${DEMO_URL}"]`);
    if (link) {
      trackDemoIntent(
        link.closest('header') ? 'header' : 'page',
        link.textContent.trim(),
      );
    }
  });

  document.addEventListener('change', event => {
    const select = event.target;
    if (
      select instanceof HTMLSelectElement &&
      select.value.includes(DEMO_URL)
    ) {
      trackDemoIntent(
        'mobile_menu',
        select.selectedOptions[0]?.textContent.trim() ?? '',
      );
    }
  });

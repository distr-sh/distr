---
let lastUpdated: Date | undefined;
try {
  lastUpdated = Astro.locals.starlightRoute.lastUpdated;
} catch {
  // Pages rendered outside Starlight, such as llms-full.txt, have no route data.
}
---

{lastUpdated && (
  <p>
    <strong>Last Updated:</strong>{' '}
    {lastUpdated.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })}
  </p>
)}

{
  "name": "distr.sh",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "copy-changelog": "cat src/content/docs/_changelog-header.md > src/content/docs/changelog.md && tail -n +2 ../CHANGELOG.md >> src/content/docs/changelog.md",
    "predev": "pnpm copy-changelog",
    "prestart": "pnpm copy-changelog",
    "prebuild": "pnpm copy-changelog",
    "precheck": "pnpm copy-changelog",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "images:unused": "node scripts/find-unused-images.mjs",
    "images:prune": "node scripts/find-unused-images.mjs --delete",
    "lint": "prettier --check .",
    "preformat": "pnpm images:prune",
    "format": "prettier --write --list-different ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/preact": "6.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.10",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.7",
    "astro-icon": "^1.2.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "github-buttons": "^2.33.1",
    "marked": "^18.1.3",
    "node-html-parser": "^9.0.7",
    "preact": "^11.2.0",
    "rehype-external-links": "^3.0.0",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "0.12.0",
    "starlight-sidebar-topics": "^0.9.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "baseline-browser-mapping": "^2.11.35",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.x"
  }
}

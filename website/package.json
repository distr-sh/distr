{
  "name": "distr.sh",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "copy-changelog": "cat src/content/docs/_changelog-header.md > src/content/docs/changelog.md && tail -n +2 ../CHANGELOG.md >> src/content/docs/changelog.md",
    "predev": "pnpm copy-changelog",
    "prestart": "pnpm copy-changelog",
    "prebuild": "pnpm copy-changelog",
    "precheck": "pnpm copy-changelog",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "screenshots:homepage": "node scripts/capture-homepage-screenshots.mjs",
    "images:unused": "node scripts/find-unused-images.mjs",
    "images:prune": "node scripts/find-unused-images.mjs --delete",
    "lint": "prettier --check .",
    "preformat": "pnpm images:prune",
    "format": "prettier --write --list-different ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.2",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@iconify-json/lucide": "^1.2.132",
    "@iconify-json/simple-icons": "^1.2.96",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.3",
    "astro-icon": "^1.2.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "github-buttons": "^2.33.0",
    "marked": "^18.0.13",
    "mermaid": "^11.17.2",
    "node-html-parser": "^8.0.4",
    "playwright": "^1.63.0",
    "preact": "^10.29.8",
    "rehype-external-links": "^3.0.0",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.35.4",
    "starlight-links-validator": "^0.26.0",
    "starlight-sidebar-topics": "^0.9.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "baseline-browser-mapping": "^2.11.23",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "26.x"
  }
}

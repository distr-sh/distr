# Please fill out all blank =""

# Distr License
# Resolved by a Distr agent at deploy time from the license key named "Distr". Replace it
# with the token itself when you deploy this stack by hand.
LICENSE_KEY={{ index .LicenseKeys "Distr" }}

# Reverse Proxy / SSL (Caddy)
# Public hostnames that Caddy serves and obtains Let's Encrypt certificates for.
# These must resolve (via DNS) to the host running this compose stack.
DISTR_APP_HOSTNAME=""
DISTR_REGISTRY_HOSTNAME=""
# Email used by the ACME provider for certificate expiry notifications.
CADDY_ACME_EMAIL=""


# General
DISTR_HOST="https://${DISTR_APP_HOSTNAME}"
JWT_SECRET="" # Generate with "openssl rand -base64 32"


# Database
# This stack does not run a database. DATABASE_URL has to point at an externally
# managed postgres instance that is reachable from the host running this stack.
DATABASE_URL=""
# DATABASE_MAX_CONNS=10

# OCI Registry Settings
# This stack does not run an object storage. The settings below have to point at an
# externally managed S3 compatible provider.
REGISTRY_ENABLED=true
REGISTRY_HOST="${DISTR_REGISTRY_HOSTNAME}" # only relevant if REGISTRY_ENABLED is true, defaults to the value of DISTR_HOST
REGISTRY_S3_BUCKET=""
REGISTRY_S3_REGION=""
REGISTRY_S3_ENDPOINT=""
REGISTRY_S3_ACCESS_KEY_ID=""
REGISTRY_S3_SECRET_ACCESS_KEY=""
REGISTRY_S3_USE_PATH_STYLE=false # true for providers that do not support virtual-hosted style requests
REGISTRY_S3_ALLOW_REDIRECT=true
REGISTRY_SCRATCH_DIR="/scratch"

# Loki (deployment and deployment target logs)
LOKI_URL="http://loki:3100"
LOKI_S3_BUCKET=""
LOKI_S3_REGION=""
LOKI_S3_ENDPOINT=""
LOKI_S3_ACCESS_KEY_ID=""
LOKI_S3_SECRET_ACCESS_KEY=""
LOKI_S3_USE_PATH_STYLE=false

# User Registration and Verification
REGISTRATION=enabled # can be one of "enabled" (default), "hidden", "disabled"
USER_EMAIL_VERIFICATION_REQUIRED=false

# Mail Sending
# MAILER_TYPE="smtp" # can be one of: "smtp", "ses"
# MAILER_FROM_ADDRESS="noreply@distr.example.com"
# MAILER_SMTP_HOST="smtp.example.com"
# MAILER_SMTP_PORT=25
# MAILER_SMTP_USERNAME="..."
# MAILER_SMTP_PASSWORD="..."
# Set MAILER_SMTP_IMPLICIT_TLS to "true", if you want to use SMTP over implicit TLS, rather than STARTTLS.
# Generally, implicit TLS is required if your SMTP port is 465.
# MAILER_SMTP_IMPLICIT_TLS=true

# Scheduled Job Config
STATUS_ENTRIES_MAX_AGE=168h
METRICS_ENTRIES_MAX_AGE=168h
# cron interval in which revision statuses older than STATUS_ENTRIES_MAX_AGE will be deleted
CLEANUP_DEPLOYMENT_REVISION_STATUS_CRON="0 * * * *"
CLEANUP_DEPLOYMENT_REVISION_STATUS_TIMEOUT="10m"
# cron interval in which metrics older than METRICS_ENTRIES_MAX_AGE will be deleted
CLEANUP_DEPLOYMENT_TARGET_METRICS_CRON="0 * * * *"
CLEANUP_DEPLOYMENT_TARGET_METRICS_TIMEOUT="10m"
# cron interval in which outdated, unused oidc state records will be deleted
CLEANUP_OIDC_STATE_CRON="0 * * * *"
CLEANUP_OIDC_STATE_CRON_TIMEOUT="10m"
# cron interval in which unreferenced artifact blobs older than CLEANUP_ARTIFACT_BLOB_MIN_AGE will be deleted from S3
# CLEANUP_ARTIFACT_BLOB_CRON="0 * * * *"
# CLEANUP_ARTIFACT_BLOB_TIMEOUT="10m"
# CLEANUP_ARTIFACT_BLOB_MIN_AGE="24h"
# cron interval in which soft-deleted organizations older than CLEANUP_ORGANIZATION_MIN_AGE will be permanently deleted (default 30 days)
# CLEANUP_ORGANIZATION_CRON="0 0 * * *"
# CLEANUP_ORGANIZATION_TIMEOUT="10m"
# CLEANUP_ORGANIZATION_MIN_AGE="720h"
# cron interval in which custom domains are checked for a CNAME record pointing at CUSTOM_DOMAIN_TARGET.
# A domain is only used for links, mails, agent manifests and registry URLs once that check has succeeded,
# so this job has to be scheduled wherever CUSTOM_DOMAIN_TARGET is set. It is a no-op otherwise.
CUSTOM_DOMAIN_VERIFICATION_CRON="*/15 * * * *"
CUSTOM_DOMAIN_VERIFICATION_TIMEOUT="4m"
# how long a verified domain is left alone before it is checked again; failing ones are checked on every run
# CUSTOM_DOMAIN_VERIFICATION_REFRESH_AFTER="12h"

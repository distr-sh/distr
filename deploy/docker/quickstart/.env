# See https://distr.sh/docs/self-hosting/configuration/ for all options
# Please fill out all blank =""

# Security (CHANGE THESE!)
JWT_SECRET="YzhScm6SfxcDlXuu/JiDhCLICXHUDKjYdp+saM02gKY=" # Generate with "openssl rand -base64 32"
# Encrypts the sensitive columns of the database. Generate with "openssl rand -base64 32".
# Back this up separately from the database: without it every encrypted value is unreadable.
DATABASE_ENCRYPTION_KEY="Ck6vQ2mXeR9tB0sZyJdLuHaNwPcFgO4iT7xVrMqEbKU="
POSTGRES_PASSWORD="distr"

# User Registration and Verification
REGISTRATION=enabled # can be one of "enabled" (default), "hidden", "disabled"
USER_EMAIL_VERIFICATION_REQUIRED=false

# Database
POSTGRES_USER="distr"
POSTGRES_DB="distr"
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# General
DISTR_HOST="https://localhost:8080"

# Object Storage (rustfs, CHANGE THE SECRET KEY!)
# rustfs has one root credential. The registry and loki derive theirs from it, so it stays above them.
RUSTFS_ACCESS_KEY="distr"
RUSTFS_SECRET_KEY="local"

# OCI Registry Settings
REGISTRY_ENABLED=true          # default false; if true, REGISTRY_S3_BUCKET and REGISTRY_S3_REGION are mandatory
REGISTRY_HOST="localhost:8585" # only relevant if REGISTRY_ENABLED is true, defaults to the value of DISTR_HOST
REGISTRY_S3_BUCKET="distr"
REGISTRY_S3_CREATE_BUCKET=true # requires s3:CreateBucket permission; set to false if the bucket already exists
REGISTRY_S3_REGION="local"
REGISTRY_S3_ENDPOINT="http://storage:9000"
REGISTRY_S3_ACCESS_KEY_ID="${RUSTFS_ACCESS_KEY}"
REGISTRY_S3_SECRET_ACCESS_KEY="${RUSTFS_SECRET_KEY}"
REGISTRY_S3_USE_PATH_STYLE=true
REGISTRY_S3_ALLOW_REDIRECT=false
# Directory used to buffer registry request bodies to temp files instead of memory.
# Must be a writable path; it is backed by the "scratch" volume in docker-compose.yaml.
REGISTRY_SCRATCH_DIR="/scratch"

# Loki (deployment and deployment target logs)
LOKI_URL="http://loki:3100"
LOKI_S3_ACCESS_KEY_ID="${RUSTFS_ACCESS_KEY}"
LOKI_S3_SECRET_ACCESS_KEY="${RUSTFS_SECRET_KEY}"

# No Mail Sending and Scheduled Job Configs recommended for Quickstart

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "postUpdateOptions": [
    "gomodTidy",
    "pnpmDedupe"
  ],
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "description": "Registries other than Docker Hub do not expose release timestamps, which would make minimumReleaseAge unsatisfiable",
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchPackageNames": [
        "github.com/go-mailx/**"
      ],
      "groupName": "go-mailx dependencies"
    },
    {
      "extends": [
        "monorepo:opentelemetry-go"
      ],
      "groupName": "opentelemetry-go monorepo"
    },
    {
      "extends": [
        "monorepo:opentelemetry-go-contrib"
      ],
      "groupName": "opentelemetry-go-contrib monorepo"
    },
    {
      "matchManagers": [
        "npm",
        "github-actions",
        "gomod",
        "dockerfile",
        "docker-compose",
        "mise"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": [
        "npm",
        "github-actions",
        "gomod",
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Automerge minor and patch releases of the noisiest GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/cache",
        "actions/checkout",
        "actions/download-artifact",
        "actions/setup-go",
        "actions/setup-node",
        "actions/upload-artifact",
        "anchore/sbom-action",
        "aws-actions/configure-aws-credentials",
        "docker/build-push-action",
        "docker/login-action",
        "docker/metadata-action",
        "docker/setup-buildx-action",
        "golangci/golangci-lint-action",
        "google/osv-scanner-action",
        "googleapis/release-please-action",
        "jdx/mise-action",
        "pnpm/action-setup",
        "sigstore/cosign-installer"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge minor and patch releases of other noisy dependencies, none of which ever needed a fix or a revert",
      "matchPackageNames": [
        "@sentry/angular",
        "@sentry/browser",
        "axllent/mailpit",
        "github.com/getsentry/sentry-go",
        "github.com/getsentry/sentry-go/**",
        "posthog-js",
        "rustfs",
        "rustfs/rustfs"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "The sentry-go modules share one version and go mod tidy bumps the rest with any one of them, which autocloses their separate PRs",
      "matchPackageNames": [
        "github.com/getsentry/sentry-go",
        "github.com/getsentry/sentry-go/**"
      ],
      "groupName": "sentry-go"
    },
    {
      "description": "Schedule noisy deps on Monday morning (6 AM - 9 AM)",
      "matchPackageNames": [
        "posthog-js",
        "@sentry/*",
        "@fontsource/*",
        "postcss"
      ],
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "matchPackageNames": [
        "distr-sh/hello-distr",
        "ghcr.io/distr-sh/hello-distr/**"
      ],
      "groupName": "distr-sh/hello-distr"
    },
    {
      "matchSourceUrls": [
        "https://github.com/golangci/golangci-lint"
      ],
      "groupName": "golangci-lint"
    },
    {
      "matchFileNames": ["website/**"],
      "matchPackageNames": ["!pnpm"],
      "groupName": "website dependencies"
    },
    {
      "description": "Silence dependency lookup warnings for enterprise images, which are not publicly available",
      "matchPackageNames": [
        "registry.distr.sh/enterprise/distr-ee"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Images of the pre_start and post_start lifecycle hooks. Renovate's docker-compose manager (https://docs.renovatebot.com/modules/manager/docker-compose/) extracts services.<name>.image only, so hook images are missed upstream. Drop this manager once it handles them. The first matchString bounds the hook block by indentation, since RE2 has no backreference for the indentation of the hook key itself.",
      "managerFilePatterns": [
        "deploy/docker/*/docker-compose.yaml"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "(?:pre_start|post_start):[ \\t]*\\n(?:[ \\t]{6,}[^\\n]*\\n)+",
        "image:[ \\t]*'?(?<depName>[^:'\\s]+):(?<currentValue>[^'\\s@]+)'?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "internal/handlers/tutorials.go",
        "frontend/ui/src/app/tutorials/registry/registry-tutorial.component.ts",
        ".github/workflows/build-distr.yaml"
      ],
      "matchStrings": [
        "\"(?<currentValue>[^\"]+)\",\\s+// renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)",
        "'(?<currentValue>[^']+)';?\\s+// renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)",
        "'(?<currentValue>[^']+)'\\s+# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)"
      ]
    }
  ]
}

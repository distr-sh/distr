FROM docker:29.10.1-cli-alpine3.24
ARG TARGETARCH
WORKDIR /
COPY LICENSE NOTICE /usr/share/doc/distr/
COPY dist/docker-controller-${TARGETARCH} /controller

# Changes daily, so BuildKit reruns the upgrade instead of reusing a cached layer.
ARG APK_UPGRADE_DATE
RUN apk upgrade --no-cache && apk add --no-cache curl

HEALTHCHECK --interval=10s --timeout=5s \
  --start-period=1m --start-interval=10s \
  CMD curl -fsS --max-time 4 http://127.0.0.1:8765 > /dev/null

ENTRYPOINT ["/controller"]
